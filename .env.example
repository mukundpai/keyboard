# Environment: production, staging, or development
NEXT_PUBLIC_APP_ENV=production

# API Configuration
NEXT_PUBLIC_API_URL=https://api.keymaster.pro
NEXT_PUBLIC_WEBSOCKET_URL=wss://ws.keymaster.pro

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Feature flags
NEXT_PUBLIC_ENABLE_CHALLENGES=true
NEXT_PUBLIC_ENABLE_LEADERBOARD=true
NEXT_PUBLIC_ENABLE_MULTIPLAYER=true

# Database/Backend (if applicable)
DATABASE_URL=
REDIS_URL=

# Authentication (if using external auth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://keymaster.pro

# Deployment
VERCEL_ENV=
VERCEL_GIT_REPO_SLUG=
