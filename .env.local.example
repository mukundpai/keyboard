# Public environment variables (safe to expose to browser)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker: matches docker-compose.yml defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/keymasterpro

# ─── Auth.js (NextAuth v5) ───────────────────────────────────────────────────
# Generate a secret: openssl rand -hex 32
AUTH_SECRET=replace-with-random-32-char-hex-secret
AUTH_URL=http://localhost:3000

# ─── Admin access ────────────────────────────────────────────────────────────
# Comma-separated list of email addresses that can access /admin
ADMIN_EMAILS=admin@yourdomain.com
